## Phase 3 — Frontend

### Step 10 — Create Gateway Vue Components

Create `resources/js/Components/Public/Gateways/CashOnDelivery.vue`:

```vue
<script setup lang="ts">
import { ref } from 'vue'
import { router } from '@inertiajs/vue3'
import AppButton from '@/Components/Shared/AppButton.vue'
import { IconTruck } from '@tabler/icons-vue'

const props = defineProps<{
    orderId:      number
    orderTotal:   number
    instructions: string
}>()

const processing = ref(false)

function placeOrder(): void {
    processing.value = true

    // COD — no payment processing, just place the order
    router.post(route('payment.confirm'), {
        gateway:   'cod',
        reference: 'cod',
        order_id:  props.orderId,
    }, {
        onFinish: () => { processing.value = false },
    })
}
</script>

<template>
    <div class="space-y-5">

        <!-- Instructions card -->
        <div class="flex gap-3 p-4 bg-warning/10 border border-warning/20 rounded-[10px]">
            <IconTruck :size="20" stroke-width="1.5" class="text-warning shrink-0 mt-0.5" />
            <div>
                <p class="text-sm font-medium text-primary mb-1">Cash on Delivery</p>
                <p class="text-sm text-[#6B6B6B]">{{ instructions }}</p>
            </div>
        </div>

        <!-- Place order button -->
        <AppButton
            variant="primary"
            size="lg"
            :loading="processing"
            :disabled="processing"
            class="w-full"
            @click="placeOrder"
        >
            <IconTruck :size="18" stroke-width="1.5" />
