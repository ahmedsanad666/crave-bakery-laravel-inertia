// In CheckoutController.php — update the create() method
public function create(): Response
{
    // Pass only enabled gateways to the checkout page
    // Order comes from sort_order set by admin
    $paymentMethods = PaymentGatewayModel::enabled()
        ->get(['name', 'label', 'description', 'logo', 'instructions'])
        ->toArray();

    return Inertia::render('Checkout/Index', [
        'order'          => OrderResource::make($this->orderService->getPendingOrder()),
        'paymentMethods' => $paymentMethods,
    ]);
}
