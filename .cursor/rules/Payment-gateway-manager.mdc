## Phase 2 — Backend Architecture

### Step 3 — Create the PaymentGateway Model

```bash
php artisan make:model PaymentGatewayModel
```

> 💡 **Best Practice:** We name it `PaymentGatewayModel` (not `PaymentGateway`) because
> we already have a `PaymentGateway` interface. Two things with the same name in the same
> namespace would cause a conflict. The model class name differs from the interface name.

```php
<?php

namespace App\Models;

use Illuminate\Database\Eloquent\Model;
use Illuminate\Database\Eloquent\Casts\Attribute;

class PaymentGatewayModel extends Model
{
    protected $table = 'payment_gateways';

    protected $fillable = [
        'name',
        'label',
        'description',
        'logo',
        'is_enabled',
        'is_test_mode',
        'config',
        'instructions',
        'sort_order',
    ];

    protected $casts = [
        'is_enabled'   => 'boolean',
        'is_test_mode' => 'boolean',
        'sort_order'   => 'integer',
    ];

    // ─── Accessors ────────────────────────────────────────────────────────────

    /**
     * Decrypt and decode the config JSON when reading.
     * Encrypt and encode when writing.
     * This keeps API keys safe even if the database is compromised.
     */
    protected function config(): Attribute
    {
        return Attribute::make(
            get: function (?string $value): array {
                if (! $value) return [];
                try {
                    return json_decode(decrypt($value), true) ?? [];
                } catch (\Exception) {
                    return [];
                }
            },
            set: function (array|null $value): ?string {
                if (! $value) return null;
                return encrypt(json_encode($value));
            },
        );
    }

    // ─── Scopes ───────────────────────────────────────────────────────────────

    /**
     * Only return gateways the admin has enabled.
     * Used in checkout to show available payment methods.
     */
    public function scopeEnabled($query)
    {
        return $query->where('is_enabled', true)->orderBy('sort_order');
    }

    // ─── Helpers ──────────────────────────────────────────────────────────────

    /**
     * Get a specific config value safely.
     * e.g. $gateway->getConfig('secret') returns the Stripe secret key
     */
    public function getConfig(string $key, mixed $default = null): mixed
    {
        return $this->config[$key] ?? $default;
    }
}
```

### Step 4 — Create the PaymentGateway Interface (Contract)

```bash
mkdir -p app/Contracts
```

Create `app/Contracts/PaymentGateway.php`:

```php
<?php

namespace App\Contracts;

use App\Models\Order;

/**
 * Every payment gateway must implement this interface.
 * This guarantees all gateways work the same way from the controller's perspective.
 *
 * HOW TO ADD A NEW GATEWAY IN THE FUTURE:
 * 1. Create app/Gateways/YourGateway.php implementing this interface
 * 2. Add it to PaymentService::resolve()
 * 3. Add a Vue component in resources/js/Components/Public/Gateways/
 * 4. Add a seeder entry for it in payment_gateways table
 * That's it — zero changes to existing code.
 */
interface PaymentGateway
{
    /**
     * Create a payment intent / session with the gateway.
     * Returns data the frontend needs to complete the payment.
     * e.g. for Stripe: ['clientSecret' => 'pi_xxx_secret_xxx']
     * e.g. for PayPal: ['orderId' => 'PAYPAL-ORDER-ID']
     * e.g. for COD:    ['method' => 'cod', 'instructions' => '...']
     */
    public function createIntent(Order $order): array;

    /**
     * Verify that a payment actually succeeded.
     * Called after the frontend reports a successful payment.
     * Always verify with the gateway directly — never trust frontend data.
     * Returns true if payment is confirmed, false otherwise.
     */
    public function verify(string $reference): bool;

    /**
     * Process a refund for a paid order.
     * Returns true if refund was successful.
     */
    public function refund(Order $order, float $amount): bool;
}
```

### Step 5 — Create Gateway Implementations

Create `app/Gateways/StripeGateway.php`:

```php
<?php

namespace App\Gateways;

use App\Contracts\PaymentGateway;
use App\Models\Order;
use App\Models\PaymentGatewayModel;
use Stripe\Stripe;
use Stripe\PaymentIntent;
use Stripe\Refund;
use Stripe\Exception\ApiErrorException;
use Illuminate\Support\Facades\Log;

class StripeGateway implements PaymentGateway
{
    private PaymentGatewayModel $gateway;

    public function __construct()
    {
        // Load config from DB — admin may have updated keys via admin panel
        $this->gateway = PaymentGatewayModel::where('name', 'stripe')->firstOrFail();

        // Set the API key from the encrypted DB config
        Stripe::setApiKey($this->gateway->getConfig('secret'));
    }

    public function createIntent(Order $order): array
    {
        // Reuse existing PaymentIntent if one already exists for this order
        if ($order->transaction_id) {
            return ['clientSecret' => $order->transaction_id];
        }

        try {
            $paymentIntent = PaymentIntent::create([
                'amount'   => (int) round($order->total * 100), // convert to cents
                'currency' => 'usd',
                'metadata' => [
                    'order_id'     => $order->id,
                    'order_number' => $order->order_number,
                    'user_id'      => $order->user_id,
                ],
                'automatic_payment_methods' => ['enabled' => true],
            ]);

            // Save the PaymentIntent ID on the order
            $order->update(['transaction_id' => $paymentIntent->id]);

            return ['clientSecret' => $paymentIntent->client_secret];

        } catch (ApiErrorException $e) {
            Log::error('Stripe createIntent failed', [
                'error'    => $e->getMessage(),
                'order_id' => $order->id,
            ]);
            throw $e;
        }
    }

    public function verify(string $reference): bool
    {
        try {
            $paymentIntent = PaymentIntent::retrieve($reference);
            return $paymentIntent->status === 'succeeded';
        } catch (ApiErrorException $e) {
            Log::error('Stripe verify failed', ['error' => $e->getMessage()]);
            return false;
        }
    }

    public function refund(Order $order, float $amount): bool
    {
        try {
            Refund::create([
                'payment_intent' => $order->transaction_id,
                'amount'         => (int) round($amount * 100),
            ]);
            return true;
        } catch (ApiErrorException $e) {
            Log::error('Stripe refund failed', [
                'error'    => $e->getMessage(),
                'order_id' => $order->id,
            ]);
            return false;
        }
    }
}
```

Create `app/Gateways/CashOnDeliveryGateway.php`:

```php
<?php

namespace App\Gateways;

use App\Contracts\PaymentGateway;
use App\Models\Order;
use App\Models\PaymentGatewayModel;

class CashOnDeliveryGateway implements PaymentGateway
{
    private PaymentGatewayModel $gateway;

    public function __construct()
    {
        $this->gateway = PaymentGatewayModel::where('name', 'cod')->firstOrFail();
    }

    /**
     * COD has no external API — just return the instructions for the customer.
     * The order is placed immediately without any payment processing.
     */
    public function createIntent(Order $order): array
    {
        // Mark the order as pending payment (they pay on delivery)
        $order->update([
            'payment_method' => 'cod',
            'payment_status' => 'pending',
            'status'         => 'processing', // we process the order immediately
        ]);

        return [
            'method'       => 'cod',
            'instructions' => $this->gateway->instructions,
        ];
    }

    /**
     * COD is verified when the delivery driver collects payment.
     * For now, we return true and let admin mark it manually.
     */
    public function verify(string $reference): bool
    {
        return true;
    }

    /**
     * COD refunds are handled offline — no API call needed.
     */
    public function refund(Order $order, float $amount): bool
    {
        // Admin handles COD refunds manually
        return true;
    }
}
```

### Step 6 — Create the PaymentService

```bash
php artisan make:service PaymentService
```

> If `make:service` doesn't exist, create manually: `app/Services/PaymentService.php`

```php
<?php

namespace App\Services;

use App\Contracts\PaymentGateway;
use App\Gateways\StripeGateway;
use App\Gateways\CashOnDeliveryGateway;
use App\Models\PaymentGatewayModel;
use Illuminate\Support\Collection;

class PaymentService
{
    /**
     * Resolve the correct gateway class based on the gateway name.
     *
     * HOW TO ADD A NEW GATEWAY:
     * 1. Create the gateway class in app/Gateways/
     * 2. Add a new case here
     * That's the only change needed in existing code.
     */
    public function resolve(string $gatewayName): PaymentGateway
    {
        return match($gatewayName) {
            'stripe' => new StripeGateway(),
            'cod'    => new CashOnDeliveryGateway(),

            // Future gateways — add cases here:
            // 'paypal'      => new PayPalGateway(),
            // 'kuveytturk'  => new KuveytTurkGateway(),
            // 'tap'         => new TapPaymentsGateway(),
            // 'myfatoorah'  => new MyFatoorahGateway(),

            default => throw new \InvalidArgumentException(
                "Payment gateway [{$gatewayName}] is not supported."
            ),
        };
    }

    /**
     * Get all gateways that the admin has enabled.
     * Used by the checkout page to show available payment options.
     */
    public function enabledGateways(): Collection
    {
        return PaymentGatewayModel::enabled()->get();
    }

    /**
     * Get a specific gateway's DB record.
     */
    public function find(string $name): PaymentGatewayModel
    {
        return PaymentGatewayModel::where('name', $name)->firstOrFail();
    }
}
```

### Step 7 — Update the PaymentController

```php
<?php

namespace App\Http\Controllers;

use App\Models\Order;
use App\Services\PaymentService;
use Illuminate\Http\Request;
use Illuminate\Http\JsonResponse;
use Inertia\Inertia;
use Inertia\Response;

class PaymentController extends Controller
{
    public function __construct(
        private readonly PaymentService $paymentService
    ) {}

    /**
     * Create a payment intent using whichever gateway the customer selected.
     * The gateway name comes from the request — it was set when the customer
     * clicked their chosen payment method on the checkout page.
     */
    public function createIntent(Request $request): JsonResponse
    {
        $request->validate([
            'order_id' => ['required', 'integer', 'exists:orders,id'],
            'gateway'  => ['required', 'string', 'in:stripe,cod'],
        ]);

        $order = Order::findOrFail($request->order_id);

        // Security: make sure this order belongs to the current user
        if ($order->user_id !== auth()->id()) {
            abort(403, 'Unauthorized.');
        }

        try {
            // Resolve the correct gateway and create the payment intent
            $gateway = $this->paymentService->resolve($request->gateway);
            $result  = $gateway->createIntent($order);

            return response()->json($result);

        } catch (\Exception $e) {
            \Log::error('Payment intent creation failed', [
                'gateway'  => $request->gateway,
                'order_id' => $order->id,
                'error'    => $e->getMessage(),
            ]);

            return response()->json([
                'error' => 'Unable to initialise payment. Please try again.',
            ], 500);
        }
    }

    /**
     * Confirm a payment after the frontend reports success.
     * Always verify with the gateway — never trust frontend data.
     */
    public function confirm(Request $request): Response
    {
        $request->validate([
            'gateway'   => ['required', 'string'],
            'reference' => ['required', 'string'],
            'order_id'  => ['required', 'integer', 'exists:orders,id'],
        ]);

        $order   = Order::findOrFail($request->order_id);
        $gateway = $this->paymentService->resolve($request->gateway);

        // Verify payment succeeded directly with the gateway
        $confirmed = $gateway->verify($request->reference);

        if (! $confirmed) {
            return Inertia::render('Checkout/Index', [
                'error' => 'Payment could not be confirmed. Please try again.',
            ]);
        }

        // Mark the order as paid
        $order->update([
            'payment_status' => 'paid',
            'payment_method' => $request->gateway,
            'status'         => 'processing',
            'paid_at'        => now(),
        ]);

        return Inertia::render('Checkout/Confirmation', [
            'order' => $order->load('items.product'),
        ]);
    }
}
```

### Step 8 — Create Admin PaymentGateway Controller

```bash
php artisan make:controller Admin/PaymentGatewayController
```

```php
<?php

namespace App\Http\Controllers\Admin;

use App\Http\Controllers\Controller;
use App\Models\PaymentGatewayModel;
use Illuminate\Http\Request;
use Illuminate\Http\RedirectResponse;
use Inertia\Inertia;
use Inertia\Response;

class PaymentGatewayController extends Controller
{
    /**
     * Show the payment gateways management page.
     * Admin sees all gateways with their current enabled/disabled state.
     */
    public function index(): Response
    {
        $gateways = PaymentGatewayModel::orderBy('sort_order')->get()->map(function ($gateway) {
            return [
                'id'           => $gateway->id,
                'name'         => $gateway->name,
                'label'        => $gateway->label,
                'description'  => $gateway->description,
                'logo'         => $gateway->logo,
                'is_enabled'   => $gateway->is_enabled,
                'is_test_mode' => $gateway->is_test_mode,
                'instructions' => $gateway->instructions,
                'sort_order'   => $gateway->sort_order,
                // Return config keys but NEVER return the actual secret values
                // Admin can see which fields are filled but not the values
                'config_fields' => $this->getConfigFields($gateway->name, $gateway->config),
            ];
        });

        return Inertia::render('Admin/Settings/Payments', [
            'gateways' => $gateways,
        ]);
    }

    /**
     * Update a gateway's settings (enable/disable, API keys, etc.)
     */
    public function update(Request $request, PaymentGatewayModel $gateway): RedirectResponse
    {
        $validated = $request->validate([
            'is_enabled'   => ['boolean'],
            'is_test_mode' => ['boolean'],
            'label'        => ['string', 'max:100'],
            'description'  => ['nullable', 'string', 'max:500'],
            'instructions' => ['nullable', 'string', 'max:1000'],
            'sort_order'   => ['integer', 'min:0'],
            'config'       => ['nullable', 'array'],
        ]);

        // Merge new config with existing — don't wipe keys the admin didn't touch
        // If a config field is submitted empty, keep the existing value
        if (isset($validated['config'])) {
            $existingConfig = $gateway->config; // auto-decrypted by model accessor
            $newConfig      = array_filter(
                $validated['config'],
                fn($value) => $value !== null && $value !== ''
            );
            $validated['config'] = array_merge($existingConfig, $newConfig);
        }

        $gateway->update($validated);

        return redirect()
            ->route('admin.settings.payments')
            ->with('success', "{$gateway->label} settings updated successfully.");
    }

    /**
     * Toggle a gateway on or off — quick action from the list page.
     */
    public function toggle(PaymentGatewayModel $gateway): RedirectResponse
    {
        $gateway->update(['is_enabled' => ! $gateway->is_enabled]);

        $status = $gateway->is_enabled ? 'enabled' : 'disabled';

        return redirect()
            ->route('admin.settings.payments')
            ->with('success', "{$gateway->label} has been {$status}.");
    }

    /**
     * Returns config field definitions for each gateway type.
     * Shows admin which fields exist and whether they are filled.
     * NEVER returns actual secret values.
     */
    private function getConfigFields(string $gatewayName, array $config): array
    {
        return match($gatewayName) {
            'stripe' => [
                ['key' => 'key',            'label' => 'Publishable Key',   'type' => 'text',     'filled' => ! empty($config['key'])],
                ['key' => 'secret',         'label' => 'Secret Key',        'type' => 'password', 'filled' => ! empty($config['secret'])],
                ['key' => 'webhook_secret', 'label' => 'Webhook Secret',    'type' => 'password', 'filled' => ! empty($config['webhook_secret'])],
            ],
            'cod' => [],  // COD has no API credentials

            // Future gateways — add their field definitions here:
            // 'paypal' => [
            //     ['key' => 'client_id',     'label' => 'Client ID',     'type' => 'text',     'filled' => !empty($config['client_id'])],
            //     ['key' => 'client_secret', 'label' => 'Client Secret', 'type' => 'password', 'filled' => !empty($config['client_secret'])],
            // ],
            // 'kuveytturk' => [
            //     ['key' => 'merchant_id',  'label' => 'Merchant ID',  'type' => 'text',     'filled' => !empty($config['merchant_id'])],
            //     ['key' => 'username',     'label' => 'Username',     'type' => 'text',     'filled' => !empty($config['username'])],
            //     ['key' => 'password',     'label' => 'Password',     'type' => 'password', 'filled' => !empty($config['password'])],
            //     ['key' => 'customer_id',  'label' => 'Customer ID',  'type' => 'text',     'filled' => !empty($config['customer_id'])],
            //     ['key' => 'store_key',    'label' => 'Store Key',    'type' => 'password', 'filled' => !empty($config['store_key'])],
            // ],

            default => [],
        };
    }
}
```

### Step 9 — Add Routes

In `routes/admin.php`:

```php
// Payment Gateway Management — inside existing admin middleware group
Route::get('/settings/payments', [Admin\PaymentGatewayController::class, 'index'])
    ->name('settings.payments');

Route::patch('/settings/payments/{gateway}', [Admin\PaymentGatewayController::class, 'update'])
    ->name('settings.payments.update');

Route::patch('/settings/payments/{gateway}/toggle', [Admin\PaymentGatewayController::class, 'toggle'])
    ->name('settings.payments.toggle');
```

In `routes/web.php` — update existing payment routes:

```php
Route::middleware('auth')->group(function () {
    // Payment — now accepts a gateway parameter
    Route::post('/payment/intent', [PaymentController::class, 'createIntent'])
        ->name('payment.intent');

    Route::post('/payment/confirm', [PaymentController::class, 'confirm'])
        ->name('payment.confirm');
});
```

