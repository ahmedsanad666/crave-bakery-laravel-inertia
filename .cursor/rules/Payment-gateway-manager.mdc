import {
    IconCreditCard, IconTruck, IconSettings,
    IconChevronDown, IconChevronUp, IconCircleCheck
} from '@tabler/icons-vue'

// ─── Types ───────────────────────────────────────────────────────────────────
interface ConfigField {
    key:    string
    label:  string
    type:   'text' | 'password'
    filled: boolean
}

interface Gateway {
    id:           number
    name:         string
    label:        string
    description:  string
    is_enabled:   boolean
    is_test_mode: boolean
    instructions: string | null
    sort_order:   number
    config_fields: ConfigField[]
}

// ─── Props ───────────────────────────────────────────────────────────────────
const props = defineProps<{
    gateways: Gateway[]
}>()

// ─── State ───────────────────────────────────────────────────────────────────
const expandedGateway = ref<string | null>(null)

// Create a form for each gateway
const forms = Object.fromEntries(
    props.gateways.map(g => [
        g.name,
        useForm({
            is_enabled:   g.is_enabled,
            is_test_mode: g.is_test_mode,
            label:        g.label,
            description:  g.description,
            instructions: g.instructions ?? '',
            sort_order:   g.sort_order,
            config:       Object.fromEntries(
                g.config_fields.map(f => [f.key, '']) // empty — never pre-fill secrets
            ),
        })
    ])
)

// ─── Icons map ───────────────────────────────────────────────────────────────
const gatewayIcons: Record<string, any> = {
    stripe: IconCreditCard,
    cod:    IconTruck,
}

// ─── Methods ─────────────────────────────────────────────────────────────────
function toggleExpand(gatewayName: string): void {
    expandedGateway.value = expandedGateway.value === gatewayName ? null : gatewayName
}

function toggleEnable(gateway: Gateway): void {
    router.patch(
        route('admin.settings.payments.toggle', { gateway: gateway.id }),
        {},
        { preserveScroll: true }
    )
}

function saveGateway(gateway: Gateway): void {
    forms[gateway.name].patch(
        route('admin.settings.payments.update', { gateway: gateway.id }),
        {
            preserveScroll: true,
            onSuccess: () => expandedGateway.value = null,
        }
    )
}
</script>

