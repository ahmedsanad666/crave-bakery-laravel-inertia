## 11. Key Component Contracts

### `ProductCard.vue`
```ts
props: {
  product: {
    id: number
    name: string
    slug: string
    short_description: string
    regular_price: number
    sale_price: number | null
    thumbnail: string
    average_rating: number
    reviews_count: number
    is_featured: boolean
    stock_status: 'in_stock' | 'out_of_stock'
    badge: string | null  // 'New' | 'Best Seller' | '20% Off' | null
    categories: Array<{ id: number, name: string }>
    is_favourited: boolean
  }
  compact: boolean  // list view mode
}
emits: ['add-to-cart', 'toggle-favourite']
```

### `AppButton.vue`
```ts
props: {
  variant: 'primary' | 'secondary' | 'danger' | 'ghost'
  size: 'sm' | 'md' | 'lg'
  loading: boolean
  disabled: boolean
  icon: Component | null
}
```

### `AppModal.vue`
```ts
props: {
  show: boolean
  title: string
  size: 'sm' | 'md' | 'lg' | 'xl'
}
emits: ['close']
// Uses Headless UI Dialog internally
```

### `SeoFields.vue` (reusable in product form, category form, and settings)
```ts
props: {
  modelValue: {
    meta_title: string
    meta_description: string
    meta_keywords: string[]
    og_image: string | null
    canonical_url: string
  }
  previewUrl: string
  previewTitle: string
}
emits: ['update:modelValue']
```

### `DataTable.vue` (admin)
```ts
props: {
  columns: Array<{ key: string, label: string, sortable: boolean }>
  rows: Array<Record<string, any>>
  loading: boolean
  selectable: boolean
}
emits: ['sort', 'select', 'select-all']
```

