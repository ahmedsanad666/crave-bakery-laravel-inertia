## Phase 3 — Frontend Setup

### Step 8 — Install Stripe.js

```bash
npm install @stripe/stripe-js
```

💡 **What Stripe.js does:** Renders the card input inside a secure Stripe-hosted iframe.
Your server NEVER sees raw card numbers. This is what makes you PCI compliant automatically.

### Step 9 — Add Publishable Key to Environment

Add to `.env`:
```env
VITE_STRIPE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
```

🔒 **Security Note:** Only `VITE_STRIPE_KEY` (publishable key starting with `pk_test_`)
goes here. Never add `STRIPE_SECRET` to any `VITE_` variable — it would be exposed in
the browser's JavaScript bundle.

### Step 10 — Create the StripePayment Vue Component

Create `resources/js/Components/Public/StripePayment.vue`:

```vue
<script setup lang="ts">
import { ref, onMounted } from 'vue'
import { loadStripe } from '@stripe/stripe-js'
import type { Stripe, StripeElements } from '@stripe/stripe-js'
import { router } from '@inertiajs/vue3'
import AppButton from '@/Components/Shared/AppButton.vue'
import { IconLock } from '@tabler/icons-vue'

// ─── Props ───────────────────────────────────────────────────────────────────
const props = defineProps<{
    orderId:    number
    orderTotal: number
}>()

// ─── State ───────────────────────────────────────────────────────────────────
const stripe     = ref<Stripe | null>(null)
const elements   = ref<StripeElements | null>(null)
const processing = ref(false)
const error      = ref<string | null>(null)
const ready      = ref(false)

// ─── Lifecycle ────────────────────────────────────────────────────────────────
onMounted(async () => {
    await initStripe()
})

// ─── Methods ──────────────────────────────────────────────────────────────────

/**
 * 1. Load Stripe.js with our publishable key
 * 2. Ask our Laravel backend to create a PaymentIntent → get clientSecret
 * 3. Mount Stripe's secure Payment Element into the DOM
 */
async function initStripe(): Promise<void> {
    // Load Stripe — uses the publishable key from .env via Vite
    stripe.value = await loadStripe(import.meta.env.VITE_STRIPE_KEY as string)

    if (!stripe.value) {
        error.value = 'Failed to load payment processor. Please refresh the page.'
        return
    }

    // Call our Laravel backend to create a PaymentIntent
    // Laravel talks to Stripe server-to-server and returns the clientSecret
    const response = await fetch(route('payment.intent'), {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            // Laravel requires CSRF token on POST requests
            'X-CSRF-TOKEN': document
                .querySelector('meta[name="csrf-token"]')
                ?.getAttribute('content') ?? '',
        },
        body: JSON.stringify({ order_id: props.orderId }),
    })

    const data = await response.json()

    if (data.error || !data.clientSecret) {
        error.value = data.error ?? 'Could not initialise payment. Please try again.'
        return
    }

    // Create Stripe Elements — the secure card input UI
    // Appearance is customised to match our Crave Bakery design system
    elements.value = stripe.value.elements({
        clientSecret: data.clientSecret,
        appearance: {
            theme: 'stripe',
            variables: {
                colorPrimary:    '#E8572A',  // our accent color
                colorBackground: '#FFFFFF',
                colorText:       '#1A1A1A',
                colorDanger:     '#C62828',  // our error color
                fontFamily:      'Inter, sans-serif',
                borderRadius:    '10px',
                fontSizeBase:    '14px',
            },
        },
    })

    // Create and mount the Payment Element into the #stripe-payment-element div
    const paymentElement = elements.value.create('payment')
    paymentElement.mount('#stripe-payment-element')

    // Mark ready once Stripe's iframe has finished loading
    paymentElement.on('ready', () => {
        ready.value = true
    })
}

/**
 * Called when user clicks "Pay Now".
 * Tells Stripe to confirm the payment using the card details entered.
 * Then notifies our Laravel backend of the result.
 */
async function pay(): Promise<void> {
    if (!stripe.value || !elements.value || processing.value) return

    processing.value = true
    error.value      = null

    // confirmPayment sends the card details to Stripe and processes the charge
    const { error: stripeError, paymentIntent } = await stripe.value.confirmPayment({
        elements: elements.value,
        redirect: 'if_required',  // handle redirect ourselves — don't auto-redirect
    })

    if (stripeError) {
        // Show Stripe's error message to the user
        // e.g. "Your card was declined" / "Incorrect CVC"
        error.value      = stripeError.message ?? 'Payment failed. Please try again.'
        processing.value = false
        return
    }

    if (paymentIntent?.status === 'succeeded') {
        // Payment worked — tell our Laravel backend to confirm the order
        router.post(route('payment.confirm'), {
            payment_intent_id: paymentIntent.id,
        })
    }
}
</script>

<template>
    <div class="space-y-5">

        <!-- Skeleton loader while Stripe iframe loads -->
        <div v-if="!ready" class="space-y-3 animate-pulse">
            <div class="h-12 bg-gray-100 rounded-[10px]" />
            <div class="h-12 bg-gray-100 rounded-[10px]" />
            <div class="h-12 bg-gray-100 rounded-[10px] w-1/2" />
        </div>

        <!-- Stripe renders the secure card form inside this div -->
        <div
            id="stripe-payment-element"
            :class="{ 'hidden': !ready }"
        />

        <!-- Error message -->
        <div
            v-if="error"
            class="flex items-center gap-2 p-3 rounded-[10px]
                   bg-error/10 border border-error/20"
        >
            <span class="text-error text-sm">{{ error }}</span>
        </div>

        <!-- Pay button — only shows once Stripe form is ready -->
        <AppButton
            v-if="ready"
            variant="primary"
            size="lg"
            :loading="processing"
            :disabled="processing"
            class="w-full"
            @click="pay"
        >
            <IconLock :size="18" stroke-width="1.5" />
            <span>
                {{ processing
                    ? 'Processing payment...'
                    : `Pay $${orderTotal.toFixed(2)}`
                }}
            </span>
        </AppButton>

        <!-- Trust message below the button -->
        <p class="text-center text-xs text-[#6B6B6B]">
            🔒 Secured by Stripe — we never store your card details
        </p>

    </div>
</template>
```

